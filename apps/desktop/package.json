{
  "name": "app-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "@tributary package — apps/desktop",
  "main": "./dist/main/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run --passWithNoTests",
    "smoke": "node e2e/electron-smoke.mjs",
    "smoke:window": "node e2e/electron-window-smoke.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@tributary/api": "workspace:*",
    "@tributary/components": "workspace:*",
    "@tributary/index": "workspace:*",
    "@tributary/jobs": "workspace:*",
    "@tributary/markdown": "workspace:*",
    "@tributary/notebook": "workspace:*",
    "@tributary/ontology": "workspace:*",
    "@tributary/render": "workspace:*",
    "@tributary/workspace": "workspace:*",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
